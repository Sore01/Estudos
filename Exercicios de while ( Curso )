import java.util.Locale;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
       
       double x = 5; 
       double y = 0;
        while (x >2){
            System.out.println(x);
            y = y + x;
            x = x - 1;
        }
            
            
        sc.close();
    }
}


