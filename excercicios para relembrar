// FORMA MAIS PROFICCIONAL 

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Escolha um número: ");
        int n = sc.nextInt();

        for (int i = 1; i <= 10; i++) {
            int resultado = n * i;
            System.out.println(n + " x " + i + " = " + resultado);
        }

        sc.close();
    }
}


