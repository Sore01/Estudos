// criando um objeto e respondendo pelo teclado

import java.util.Scanner;

public class Main {
    public static void main(String[] args){

       // essa é a criação de um objeto com uma entrada pelo teclado
       
        Scanner sc = new Scanner(System.in);

        String x;
        x = sc.next();
        System.out.println("Voce digitou: "+ x);




        sc.close();
    }
}

