//limpar um buffer de leitura

import java.util.Scanner;

public class Main {
    public static void main(String[] args){

        Scanner sc = new Scanner(System.in);

        int x;
        String s1, s2, s3;

        // para o nextInt ele usa um espaço e faz com que o s1 fique em branco
        // para isso deve ser usado um nextline á mais para ficar no lugar do perdido

        x = sc.nextInt();
        sc.nextLine();
        s1 = sc.nextLine();
        s2 = sc.nextLine();
        s3 = sc.nextLine();

        System.out.println("Dados digitados: ");
        System.out.println(x);
        System.out.println(s1);
        System.out.println(s2);
        System.out.println(s3);

        sc.close();
    }
}
























