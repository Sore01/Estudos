class Aluno {

    private String nome;
    private double nota;

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public double getNota() {
        return nota;
    }

    public void estudar() {
        System.out.println(nome + " Estudou");

        if (nota >= 10) {
            System.out.println(nome + " nota máxima atingida: 10");
        }
        else  {
            setNota(nota + 0.5);
            System.out.println(nome + nota);
        }

    }

    public void setNota(double nota) {
        this.nota = nota;
    }



}















































