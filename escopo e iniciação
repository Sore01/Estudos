// pode ser usada tambe um else para que a estrutura  va de um jeito ou de outro pois o compilador pode entender que a estrutura  esta incoerente e ele possa  pular alguma etapa.


public class Main {
    public static void main(String[] args) {

        double price = 400.00;

        double discount;

        if (price < 200){
            double discount = price * 0.1;
        }
        else {
            discount = 0;
        }

        System.out.println(discount);
    }
}


