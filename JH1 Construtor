public class Produto {
    String nome;
    double preco;

    public Produto(String nome, double preco) {
        this.nome = nome;
        this.preco = preco;
    }

    public void mostrarInfo() {
        System.out.println("Produto: " + nome + " - R$" + preco);
    }
}

class Main {
    public static void main(String[] args) {
        Produto produto1 = new Produto("Caderno", 15.5);
        produto1.mostrarInfo();

        
        Produto produto2 = new Produto("Lapis", 5.5);
        produto2.mostrarInfo();
    }
}




