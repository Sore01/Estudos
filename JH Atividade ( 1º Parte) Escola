public class Aluno {

    public String nome;
    public int idade;
    public double nota;
    public int frequencia;
    public boolean matricula;
    public boolean bolsista;

    public boolean notaOk() {
        return nota >= 7;
    }

    public boolean frequenciaOk() {
        return frequencia >= 75;
    }

    public boolean estaAprovado() {
        return notaOk() && frequenciaOk();
    }

    public void receberBolsa() {
        bolsista = true;
    }

    public void verificarBolsa() {
        if (bolsista) {
            if (nota >= 7) {
                System.out.println(nome + ": Bolsa mantida!");
            } else {
                System.out.println(nome + ": Bolsa em risco.");
            }
        } else {
            System.out.println(nome + ": Aluno não tem bolsa");
        }
    }

