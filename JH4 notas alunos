import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Aluno aluno1 = new Aluno();

        aluno1.setNome("Margarida");
        aluno1.setNota(8.5);

        System.out.println(aluno1.getNome());
        System.out.println(aluno1.getNota());


        Aluno aluno2 = new Aluno();

        aluno2.setNome("Joao");
        aluno2.setNota(5.0);

        System.out.println(aluno2.getNome());
        System.out.println(aluno2.getNota());


        Aluno aluno3 = new Aluno();

        aluno3.setNome("Moyses");
        aluno3.setNota(3.0);

        System.out.println(aluno3.getNome());
        System.out.println(aluno3.getNota());


        aluno1.estudar();
        aluno2.estudar();
        aluno3.estudar();

    }
}

class Aluno {

    private String nome;
    private double nota;

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public double getNota() {
        return nota;
    }

    public void estudar(){
        System.out.println(nome + " Estudou");
        nota = nota + (0.5);
        System.out.println(nome + " Estudou: " + nota);


    }

    public void setNota(double nota) {
        this.nota = nota;
    }


}


