// area de um retangulo com 3 valores


public class Main {
    public static void main(String[] args){

        double b, B, h, area;

        // (boas praticas) Para numeros tem que indicar a expressão fopr pronto flutuante (não inteira). double usa .0 e float usa f

        b = 6f;
        B = 8f;
        h = 5f;

        area = (b+B) / 2f * h;

        System.out.println(area);


    }
}


