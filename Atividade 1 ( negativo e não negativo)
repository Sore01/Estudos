import java.util.Scanner;

public class Main {


    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int hora;

        System.out.println("Quantos horas?");
        hora = sc.nextInt();

        if (hora < 0) {
            System.out.println("Negativo");
        }

        else {
            System.out.println("NÃo NEGATIVO");
        }
        sc.close();
    }
}
